#version 460
#extension GL_EXT_scalar_block_layout : require
#extension GL_KHR_shader_subgroup_basic : require

layout( local_size_x = 1, local_size_y = 1, local_size_z = 1 ) in;

#define NRC_SET 12
#define NRC_BINDING_TRAIN_COUNTS 2
#define NRC_BINDING_OPTIMIZER_STATE 7
#define NRC_BINDING_DISPATCH_CMD 8
#define NRC_BINDING_PARAMS 11

#define NRC_TRAIN_BATCH_COUNT 4
#define NRC_TRAIN_BATCH_SIZE 16384
#define NRC_TRAIN_RECORD_CAPACITY ( NRC_TRAIN_BATCH_COUNT * NRC_TRAIN_BATCH_SIZE )
#define NRC_HIDDEN_LAYERS 5
#define NRC_WEIGHT_COUNT ( 64 * 64 * NRC_HIDDEN_LAYERS + 64 * 3 )
#define NRC_ADAM_BETA1 0.9
#define NRC_ADAM_BETA2 0.999
#define NRC_EMA_ALPHA 0.99

struct NRCDispatchCmd
{
    uint x;
    uint y;
    uint z;
};

struct NRCOptimizerState
{
    uint  uStep;
    float uBeta1_T;
    float uBeta2_T;
    float uAlpha_T;
    float uAlpha_T_1;
};

struct NRCFrameParams
{
    vec4  uPosNormalizeScale;
    vec4  uPosNormalizeCenter;
    uint  uFrameId;
    uint  uWidth;
    uint  uHeight;
    float uTrainProbability;
    uint  uTrainBatchSize;
    float uLearningRate;
    float uEmaAlpha;
};

layout( set = NRC_SET, binding = NRC_BINDING_TRAIN_COUNTS, scalar ) buffer NRCTrainCountsBuffer
{
    uint uTotalTrainCount;
};

layout( set = NRC_SET, binding = NRC_BINDING_OPTIMIZER_STATE, scalar ) buffer NRCOptimizerStateBuffer
{
    NRCOptimizerState uOptimizerState;
};

layout( set = NRC_SET, binding = NRC_BINDING_DISPATCH_CMD, scalar ) buffer NRCDispatchCmdBuffer
{
    NRCDispatchCmd uDispatchCmd;
};

layout( set = NRC_SET, binding = NRC_BINDING_PARAMS, scalar ) uniform NRCParamsUBO
{
    NRCFrameParams uNRCParams;
};

void main()
{
    // runtime batch size knob (already clamped to capacity on the host)
    uint maxCount = min( uNRCParams.uTrainBatchSize, NRC_TRAIN_RECORD_CAPACITY );
    uint count    = min( uTotalTrainCount, maxCount );

    uDispatchCmd.x = ( count + 127 ) / 128;
    uDispatchCmd.y          = 1;
    uDispatchCmd.z          = 1;

    if( count > 0 )
    {
        uOptimizerState.uStep++;
        uOptimizerState.uBeta1_T *= NRC_ADAM_BETA1;
        uOptimizerState.uBeta2_T *= NRC_ADAM_BETA2;
        uOptimizerState.uAlpha_T_1 = uOptimizerState.uAlpha_T;
        // runtime EMA alpha knob; fall back to the compile-time default when
        // the host uploads an out-of-range value
        float emaAlpha = ( uNRCParams.uEmaAlpha > 0.0 && uNRCParams.uEmaAlpha < 1.0 )
                             ? uNRCParams.uEmaAlpha
                             : NRC_EMA_ALPHA;
        uOptimizerState.uAlpha_T *= emaAlpha;
    }
}
